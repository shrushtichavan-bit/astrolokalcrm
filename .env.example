# Generic Postgres connection string — works against any Postgres-compliant
# database (Supabase's own Postgres, self-hosted, RDS, etc). Required by
# src/lib/db.ts, which replaced the old Supabase JS client entirely.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Signs/verifies session cookies (src/lib/auth.ts). Set a real random value —
# falls back to an insecure dev default if unset.
JWT_SECRET=

# Still required — NOT database access. Admin > Sync from Sheet calls the
# deployed intake-lead Supabase Edge Function directly over HTTP
# (src/lib/actions/sheet-sync-actions.ts) using these two, independent of the
# app's own DB connection above.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Sheets service-account credentials for Sync from Sheet (reads the
# sheet; the anon key above is what writes the row back via intake-lead).
GOOGLE_SERVICE_ACCOUNT_KEY=
